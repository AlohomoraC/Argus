# Copy to .env (git-ignored) and fill in what your config references as ${VAR}.

# Delivery
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: raises the GitHub search rate limit for the "GitHub new repos" source
GITHUB_TOKEN=

# Network proxy, if your network needs one to reach the sources or the model API.
# Values here apply to every run (also scheduled ones); `schedule install` also copies them from your shell.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Unattended runs on a Claude subscription: interactive logins expire; create a long-lived token with
# `claude setup-token` and paste it here.
# CLAUDE_CODE_OAUTH_TOKEN=

# Only needed where the CLI is not logged in (CI, servers):
# ANTHROPIC_API_KEY=      used by `claude -p` (llm.backend = claude-cli)
# OPENAI_API_KEY=         log Codex in with: printenv OPENAI_API_KEY | codex login --with-api-key
