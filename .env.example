# Copy to .env (git-ignored) and fill in what your config references as ${VAR}.

# Delivery
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Optional: raises the GitHub search rate limit for the "GitHub new repos" source
GITHUB_TOKEN=

# Only needed where the CLI is not logged in (CI, servers):
# ANTHROPIC_API_KEY=      used by `claude -p` (llm.backend = claude-cli)
# OPENAI_API_KEY=         log Codex in with: printenv OPENAI_API_KEY | codex login --with-api-key
